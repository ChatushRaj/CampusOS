# ---------------------------------------------------------------
# CampusOS API — environment configuration
# Copy this file to `.env` and replace every placeholder value.
# Never commit the resulting `.env` file.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4000

# MySQL connection string.
# Create the database first:  CREATE DATABASE campusos CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql://root:your-password@127.0.0.1:3306/campusos
DB_POOL_SIZE=10

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Signing secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# One-time code required to register a Faculty or Admin account
STAFF_INVITE_CODE=replace-with-a-private-code

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Public base URL used to build absolute media links
PUBLIC_URL=http://localhost:4000
